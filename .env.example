# Public site URL — used for canonical links, sitemap, robots.txt, and Open
# Graph metadata. Set this to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to enable the privacy-conscious Core Web Vitals beacon
# (sends metric name/value/path only — no cookies, no PII) to /api/vitals.
NEXT_PUBLIC_ENABLE_VITALS=false

# ---------------------------------------------------------------------------
# The items below are NOT required to run this project as-is (the demo uses
# in-memory data and simulated checkout), but are the integration points
# you would wire up for a real production deployment:
# ---------------------------------------------------------------------------

# Payments (e.g. Stripe) — would replace the simulated order flow in
# src/lib/actions/checkout-actions.ts
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Database (e.g. Postgres via Prisma/Drizzle) — would replace
# src/lib/data/products.ts and src/lib/data/orders-store.ts
# DATABASE_URL=

# Transactional email (e.g. Resend) — order confirmations, newsletter
# RESEND_API_KEY=
